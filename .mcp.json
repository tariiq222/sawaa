{
  "mcpServers": {
    "chrome-devtools": {
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@latest"
      ]
    },
    "postgres": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-postgres",
        "postgresql://deqah:deqah_dev_password@localhost:5999/deqah_dev"
      ]
    },
    "e2e": {
      "command": "pnpm",
      "args": [
        "exec",
        "e2e",
        "mcp"
      ],
      "env": {
        "E2E_TELEMETRY_DISABLED": "1"
      }
    },
    "jev-review": {
      "type": "stdio",
      "command": "/Users/tariq/.local/bin/node",
      "args": ["/Users/tariq/code/sawaa/scripts/mcp/jev-review.cjs"]
    }
  }
}
