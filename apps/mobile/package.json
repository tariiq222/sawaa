{
  "name": "sawaa-mobile",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "postinstall": "pnpm --filter @sawaa/shared build",
    "dev": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "jest --coverage",
    "test:watch": "jest --watch"
  },
  "jest": {
    "preset": "jest-expo",
    "collectCoverageFrom": [
      "app/**/*.{ts,tsx}",
      "components/**/*.{ts,tsx}",
      "constants/**/*.{ts,tsx}",
      "hooks/**/*.{ts,tsx}",
      "lib/**/*.{ts,tsx}",
      "plugins/**/*.js",
      "services/**/*.{ts,tsx}",
      "stores/**/*.{ts,tsx}",
      "theme/**/*.{ts,tsx}",
      "types/**/*.{ts,tsx}",
      "utils/**/*.{ts,tsx}",
      "!**/__tests__/**",
      "!**/*.test.{ts,tsx}",
      "!**/*.d.ts"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 46,
        "branches": 36,
        "functions": 40,
        "lines": 47
      }
    },
    "moduleNameMapper": {
      "^immer$": "<rootDir>/node_modules/.pnpm/node_modules/immer/dist/cjs/index.js",
      "^uuid$": "<rootDir>/node_modules/.pnpm/node_modules/uuid/dist/cjs/index.js"
    }
  },
  "dependencies": {
    "@expo-google-fonts/ibm-plex-sans-arabic": "^0.4.2",
    "@expo/metro-runtime": "~55.0.6",
    "@expo/vector-icons": "^15.0.2",
    "@hookform/resolvers": "^5.2.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-firebase/app": "26.4.0",
    "@react-native-firebase/messaging": "26.4.0",
    "@react-navigation/native": "^7.1.33",
    "@reduxjs/toolkit": "^2.11.2",
    "@sawaa/shared": "workspace:*",
    "@sentry/react-native": "~7.11.0",
    "@tanstack/react-query": "^5.100.1",
    "accepts": "^1.3.8",
    "axios": "^1.20.0",
    "bytes": "^3.1.2",
    "compressible": "^2.0.18",
    "expo": "~55.0.31",
    "expo-blur": "~55.0.18",
    "expo-build-properties": "~55.0.18",
    "expo-constants": "~55.0.9",
    "expo-device": "~55.0.21",
    "expo-font": "~55.0.8",
    "expo-glass-effect": "~55.0.11",
    "expo-haptics": "~55.0.18",
    "expo-image-picker": "~55.0.24",
    "expo-linear-gradient": "~55.0.18",
    "expo-linking": "~55.0.17",
    "expo-notifications": "~55.0.27",
    "expo-router": "~55.0.18",
    "expo-secure-store": "~55.0.18",
    "expo-splash-screen": "~55.0.25",
    "expo-status-bar": "~55.0.4",
    "expo-symbols": "~55.0.9",
    "expo-updates": "~55.0.31",
    "expo-web-browser": "~55.0.20",
    "exponential-backoff": "^3.1.3",
    "i18next": "^25.10.2",
    "lucide-react-native": "^0.577.0",
    "on-headers": "^1.1.0",
    "parse-png": "^2.1.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-hook-form": "^7.71.2",
    "react-i18next": "^16.6.0",
    "react-native": "0.83.10",
    "react-native-calendars": "^1.1314.0",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-gifted-chat": "^3.3.2",
    "react-native-keyboard-controller": "1.20.7",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.7.4",
    "react-redux": "^9.2.0",
    "redux-persist": "^6.0.0",
    "safe-buffer": "^5.2.1",
    "vary": "^1.1.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@sentry/cli": "2.58.4",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "29.5.14",
    "@types/node": "^22.10.0",
    "@types/react": "~19.2.2",
    "@typescript-eslint/eslint-plugin": "8.59.1",
    "@typescript-eslint/parser": "8.59.1",
    "eslint": "9.39.4",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "jest-expo": "~55.0.22",
    "react-test-renderer": "19.2.0",
    "typescript": "~5.9.2"
  },
  "private": true,
  "pnpm": {
    "patchedDependencies": {
      "metro@0.83.7": "patches/metro@0.83.7.patch",
      "expo-router@55.0.18": "patches/expo-router@55.0.18.patch",
      "decode-uri-component@0.2.2": "patches/decode-uri-component@0.2.2.patch"
    },
    "overrides": {
      "@grpc/grpc-js@<1.14.5": "1.14.5",
      "@expo/plist>@xmldom/xmldom": "0.8.15",
      "plist>@xmldom/xmldom": "0.9.12",
      "metro>image-size": "2.0.4",
      "@expo/xcpretty>js-yaml": "4.3.2",
      "@istanbuljs/load-nyc-config>js-yaml": "3.15.2",
      "brace-expansion@<1.1.19": "1.1.21",
      "brace-expansion@>=5.0.0 <5.0.11": "5.0.12",
      "uuid@<11.1.1": "11.1.1",
      "moment@<2.31.0": "2.31.0"
    }
  }
}
