// AI BC — knowledge base, embeddings (pgvector), RAG chat sessions.
// Uses the `vector` type from pgvector declared in main.prisma.
// SaaS-02f: ChatSession + ChatMessage scoped; ChatbotConfig converted to org singleton.
// SaaS-02g: KnowledgeDocument + DocumentChunk scoped.

enum DocumentStatus {
  PENDING
  EMBEDDED
  FAILED
}

enum AiProvider {
  OPENROUTER
  OPENAI
}

enum AiConnectionStatus {
  NOT_CONFIGURED
  CONNECTED
  FAILED
  RETEST_REQUIRED
}

// Single-tenant provider settings. singletonKey prevents concurrent upserts
// from creating more than one configuration row.
model AiProviderConfig {
  id                   String             @id @default(uuid())
  singletonKey         String             @unique @default("singleton")
  provider             AiProvider
  credentialCiphertext String
  configVersion        Int                @default(0)
  testedConfigHash     String?
  model                String
  temperature          Float              @default(0.4)
  maxTokens            Int                @default(800)
  isEnabled            Boolean            @default(false)
  connectionStatus     AiConnectionStatus @default(NOT_CONFIGURED)
  lastTestedAt         DateTime?
  lastTestOk           Boolean?
  lastTestErrorCode    String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
}

// ─── Knowledge Base ───────────────────────────────────────────────────────────

model KnowledgeDocument {
  id                 String         @id @default(uuid())
  title              String
  sourceType         String // "manual" | "url" | "file"
  sourceRef          String? // URL or MinIO object key
  content            String?
  isPublished        Boolean        @default(false)
  publishedAt        DateTime?
  lastIndexedAt      DateTime?
  lastIndexErrorCode String?
  contentHash        String?
  indexingLeaseOwner  String?
  indexingLeaseExpiresAt DateTime?
  status             DocumentStatus @default(PENDING)
  metadata           Json?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  chunks DocumentChunk[]

  @@index([status])
  @@index([isPublished, status])
  @@index([createdAt])
  @@index([indexingLeaseExpiresAt])
}

model DocumentChunk {
  id         String                       @id @default(uuid())
  documentId String
  content    String
  // Hash of the document content version used to create this chunk. Search
  // requires this to equal KnowledgeDocument.contentHash.
  indexedContentHash String?
  embedding  Unsupported("vector(1536)")?
  chunkIndex Int
  tokenCount Int                          @default(0)
  createdAt  DateTime                     @default(now())

  document KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
}

// ─── Chat Sessions ────────────────────────────────────────────────────────────

model ChatSession {
  id        String   @id @default(uuid())
  clientId  String?
  userId    String?
  title     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages ChatMessage[]

  @@index([createdAt])
  @@index([clientId])
}

// ─── Chatbot Config ───────────────────────────────────────────────────────────

model ChatbotConfig {
  id                String   @id @default(uuid())
  systemPromptAr    String?
  systemPromptEn    String?
  greetingAr        String?
  greetingEn        String?
  escalateToHumanAt Int? // message count threshold; null = never auto-escalate
  settings          Json? // catchall for future keyed settings
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model ChatMessage {
  id         String   @id @default(uuid())
  sessionId  String
  role       String // "user" | "assistant" | "system"
  content    String
  tokensUsed Int      @default(0)
  model      String?
  createdAt  DateTime @default(now())

  session ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
}
