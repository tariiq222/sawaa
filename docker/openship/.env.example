# Sawaa OpenShip isolated runtime environment.
# Use this as an environment-key inventory; never commit filled values.
# Put only non-secret values into the OpenShip project/global environment.
# This template intentionally contains no production credentials or provider keys.
# OpenShip project/global environment can reach every service. Keep that scope
# limited to non-secret paths, image refs, network names, and public/build URLs.
# Enter credential and encryption values only in the owning service's scoped
# environment (duplicate a shared credential only on the services that need it).

RUNTIME_NETWORK=openship-sawaa-staging
# Required absolute host paths. Prepare protected, isolated directories and
# restore approved data before launching; do not reuse old rehearsal paths.
POSTGRES_DATA_PATH=/var/lib/webvue-apps/sawaa/openship-staging/postgres
REDIS_DATA_PATH=/var/lib/webvue-apps/sawaa/openship-staging/redis
MINIO_DATA_PATH=/var/lib/webvue-apps/sawaa/openship-staging/minio

POSTGRES_IMAGE=sawaa-postgres:18-pgvector
BACKEND_IMAGE=sawaa-backend:staging
DASHBOARD_IMAGE=sawaa-dashboard:staging
WEBSITE_IMAGE=sawaa-website:staging

POSTGRES_USER=sawaa_owner
POSTGRES_PASSWORD=
POSTGRES_DB=sawaa_staging
# Provision this restricted role explicitly before starting the backend.
# This image does not create the app role; restored volumes must contain it.
APP_DB_USER=sawaa_app
APP_DB_PASSWORD=
# Use URL-encoded credentials and include pool settings in production mode.
APP_DATABASE_URL=
# Required only in the backend service scope for startup migration. Never put
# this owner URL in project/global environment or any frontend service. The
# optional compose.migration.yml recovery service can scope the same key to
# its one-shot migrate service; it is never passed to the running app process.
MIGRATION_DATABASE_URL=

NODE_ENV=staging
DB_STATEMENT_TIMEOUT_MS=30000
DB_POOL_TIMEOUT_S=20
DB_CONNECTION_LIMIT=10
REDIS_PASSWORD=
REDIS_DB=0

MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=sawaa
MINIO_USE_SSL=false
# Set only to a staging-reachable host when browser presigned URLs are tested.
MINIO_PUBLIC_ENDPOINT=
MINIO_PUBLIC_PORT=
MINIO_PUBLIC_USE_SSL=

# Public staging origins. Use the real ingress/tunnel URLs for a browser run.
API_PUBLIC_URL=https://api.sawaa.staging.example
DASHBOARD_PUBLIC_URL=https://dashboard.sawaa.staging.example
PUBLIC_WEBSITE_URL=https://sawaa.staging.example
CORS_ORIGINS=https://dashboard.sawaa.staging.example,https://sawaa.staging.example
# Dashboard's Next rewrite is server-side and currently reads only
# NEXT_PUBLIC_API_URL. Keep this target reachable from the dashboard container.
DASHBOARD_API_URL=http://backend:5100/api/v1
# Website browser bundle requires a public API URL; website SSR uses INTERNAL_API_URL.
NEXT_PUBLIC_API_URL=https://api.sawaa.staging.example/api/v1
NEXT_PUBLIC_DEFAULT_ORG_ID=00000000-0000-0000-0000-000000000001
NEXT_PUBLIC_WEB_CHAT_ENABLED=false

# Generate distinct values locally. These are required by backend validation.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_CLIENT_ACCESS_SECRET=
JWT_OTP_SECRET=
CHAT_GUEST_TOKEN_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
# Optional dedicated mobile review account UUID. Empty keeps review login disabled.
MOBILE_REVIEW_CLIENT_ID=
JWT_CLIENT_ACCESS_TTL=15m
JWT_CLIENT_REFRESH_TTL=7d

AI_PROVIDER_ENCRYPTION_KEY=
MOYASAR_ENCRYPTION_KEY=
SMS_PROVIDER_ENCRYPTION_KEY=
ZOOM_PROVIDER_ENCRYPTION_KEY=
EMAIL_PROVIDER_ENCRYPTION_KEY=
PLATFORM_SETTINGS_KEY=
SUPER_ADMIN_PASSWORD=
INTERNAL_METRICS_ALLOWED_IPS=127.0.0.1,::1
INTERNAL_METRICS_TOKEN=

# Keep all provider credentials empty in the isolated rehearsal. Network policy
# must also deny provider egress; empty values alone do not neutralize cloned DB config.
AUTHENTICA_API_KEY=
# Replace with the approved provider endpoint only when provider use is approved.
AUTHENTICA_BASE_URL=https://authentica.invalid
AUTHENTICA_DEFAULT_TEMPLATE_ID=1
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.invalid/api/v1
OPENROUTER_CHAT_MODEL=deepseek/deepseek-v4-flash-0731
SMS_WEBHOOK_URL_BASE=

WEB_CHAT_ENABLED=false
NOTIFICATION_OUTBOX_CAPTURE_ENABLED=false
NOTIFICATION_OUTBOX_DELIVERY_ENABLED=false
NOTIFICATION_OUTBOX_CUTOVER_AT=
RETENTION_CHAT_DAYS=365
THROTTLER_DISABLED=false
MOBILE_OTP_FULL_BYPASS=false
TENANT_ENFORCEMENT=off
DEFAULT_ORGANIZATION_ID=00000000-0000-0000-0000-000000000001
