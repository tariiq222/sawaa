// Comms BC — notifications, chat, email templates.
// Phase 9 (p9-t*).

enum NotificationType {
  BOOKING_CREATED
  BOOKING_CONFIRMED
  BOOKING_CANCELLED
  BOOKING_REMINDER
  PAYMENT_RECEIVED
  PAYMENT_FAILED
  PAYMENT_COMPLETED
  PAYMENT_REMINDER
  WELCOME
  GENERAL
}

enum RecipientType {
  CLIENT
  EMPLOYEE
}

enum ConversationStatus {
  OPEN
  CLOSED
}

enum MessageSenderType {
  CLIENT
  EMPLOYEE
  AI
}

model Notification {
  id            String           @id @default(uuid())
  recipientId   String
  recipientType RecipientType
  type          NotificationType
  title         String
  body          String
  metadata      Json?
  isRead        Boolean          @default(false)
  readAt        DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([recipientId])
  @@index([recipientId, isRead, createdAt]) // DB-06: replaces (recipientId, createdAt) — adds isRead to avoid heap filter
}

model ChatConversation {
  id            String             @id @default(uuid())
  clientId      String
  employeeId    String?
  isAiChat      Boolean            @default(false)
  status        ConversationStatus @default(OPEN)
  lastMessageAt DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  messages CommsChatMessage[]

  @@index([clientId])
  @@index([employeeId])
  @@index([status, lastMessageAt])
}

model CommsChatMessage {
  id             String            @id @default(uuid())
  conversationId String
  conversation   ChatConversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderType     MessageSenderType
  senderId       String?
  body           String
  isRead         Boolean           @default(false)
  createdAt      DateTime          @default(now())

  @@index([conversationId, createdAt])
}

enum ContactMessageStatus {
  NEW
  READ
  REPLIED
  ARCHIVED
}

model ContactMessage {
  id         String               @id @default(uuid())
  name       String
  phone      String?
  email      String?
  subject    String?
  body       String
  status     ContactMessageStatus @default(NEW)
  createdAt  DateTime             @default(now())
  readAt     DateTime?
  archivedAt DateTime?

  @@index([status, createdAt])
}

model EmailTemplate {
  id        String   @id @default(uuid())
  slug      String
  name      String
  subject   String
  htmlBody  String
  blocks    Json? // SaaS — block-builder source of truth; htmlBody is rendered from this
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// SaaS-02g-sms — per-tenant SMS provider configuration.

enum SmsProvider {
  NONE
  UNIFONIC
  TAQNYAT
}

enum SmsDeliveryStatus {
  QUEUED
  SENT
  DELIVERED
  FAILED
  UNKNOWN
}

model OrganizationSmsConfig {
  id                    String      @id @default(uuid())
  provider              SmsProvider @default(NONE)
  senderId              String? // e.g. "Deqah" or per-tenant brand
  // Encrypted credential payload (AES-GCM). JSON-stringified provider-specific fields.
  credentialsCiphertext String? // base64(nonce || tag || ciphertext)
  webhookSecret         String? // HMAC secret for DLR signature
  lastTestAt            DateTime?
  lastTestOk            Boolean?
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
}

model SmsDelivery {
  id                String            @id @default(uuid())
  provider          SmsProvider
  toPhone           String
  body              String
  bodyHash          String // sha256, used for idempotency with retries
  status            SmsDeliveryStatus @default(QUEUED)
  providerMessageId String?           @unique
  errorCode         String?
  errorMessage      String?
  sentAt            DateTime?
  deliveredAt       DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([status, createdAt]) // DB-06: replaces (status) + (createdAt) — composite for retry sweep
}

// SaaS-email-provider — per-tenant email provider configuration.

enum EmailProvider {
  NONE
  SMTP
  RESEND
  SENDGRID
  MAILCHIMP
}

model OrganizationEmailConfig {
  id                    String        @id @default(uuid())
  provider              EmailProvider @default(NONE)
  senderName            String? // e.g. "عيادة الأمل"
  senderEmail           String? // e.g. "noreply@clinic.com"
  // Encrypted credential payload (AES-GCM). JSON-stringified provider-specific fields.
  credentialsCiphertext String? // base64(nonce || tag || ciphertext)
  lastTestAt            DateTime?
  lastTestOk            Boolean?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
}

model FcmToken {
  id         String   @id @default(uuid())
  clientId   String
  token      String
  platform   String   @db.VarChar(8)
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@unique([clientId, token], name: "fcm_token_per_client")
  @@index([clientId])
}

// Notification delivery log — resilient multi-channel dispatch tracking.

enum DeliveryChannel {
  EMAIL
  SMS
  PUSH
  IN_APP
}

enum DeliveryStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

enum NotificationPriority {
  CRITICAL
  STANDARD
}

enum NotificationSenderActor {
  PLATFORM
  TENANT
  PLATFORM_FALLBACK
}

model NotificationDeliveryLog {
    id            String                  @id @default(uuid())
    recipientId   String
    type          NotificationType
    priority      NotificationPriority    @default(STANDARD)
    channel       DeliveryChannel
    status        DeliveryStatus          @default(PENDING)
    toAddress     String?
    providerName  String?
    senderActor   NotificationSenderActor @default(TENANT)
    attempts      Int                     @default(0)
    lastAttemptAt DateTime?
    sentAt        DateTime?
    errorMessage  String?
    jobId         String?
    createdAt     DateTime                @default(now())
    updatedAt     DateTime                @updatedAt

    @@index([status])
    @@index([type])
    @@index([status, createdAt]) // DB-06: composite for retry sweep — replaces standalone (createdAt)
}

// ─── WhatsApp Agent ───────────────────────────────────────────────────────────
// Single-tenant WhatsApp AI agent. Singleton config (findFirst + create-if-missing);
// conversations and messages are persisted for live monitoring + audit trail.
// See migration 20260730000000_whatsapp_agent_config.

enum WhatsappProvider {
    META_CLOUD
    EVOLUTION_API
}

enum WhatsappConversationStatus {
    ACTIVE
    COMPLETED
    ABANDONED
    TAKEOVER
    BLOCKED
}

enum WhatsappMessageRole {
    USER
    ASSISTANT
    STAFF
    TOOL
    SYSTEM
}

enum WhatsappDeliveryStatus {
    PENDING
    SENT
    FAILED
}

model WhatsappAgentConfig {
    id                    String          @id @default(uuid())
    provider              WhatsappProvider @default(EVOLUTION_API)
    // Evolution API: base URL + API key (encrypted) + instance name
    evolutionBaseUrl      String?
    evolutionInstanceName String?
    // Encrypted blob (AES-256-GCM) — base64(iv||tag||ciphertext)
    // Holds: { evolutionApiKey, phoneNumberId?, businessAccountId?, accessToken?, webhookSecret? }
    credentialsCiphertext String?
    // Webhook verify secret (encrypted separately for independent rotation)
    webhookSecretEnc      String?
    isActive              Boolean         @default(true)
    // AI / LLM settings (plain — not secrets)
    aiModel               String          @default("qwen/qwen3.5-plus-02-15")
    aiTemperature         Float           @default(0.4)
    aiMaxTokens           Int             @default(800)
    // OpenRouter / OpenAI compatible API key — encrypted at rest (write-only).
    // When present, overrides the OPENROUTER_API_KEY env var at runtime.
    aiApiKeyEncrypted     String?
    systemPromptAr        String          @default("")
    systemPromptEn        String          @default("")
    greetingAr            String?
    greetingEn            String?
    defaultLanguage       String          @default("ar")
    businessHoursOnly     Boolean         @default(false)
    activeDays            Int[]           @default([0, 1, 2, 3, 4])
    // Runtime state (mirrored from Evolution API on each poll)
    isConnected           Boolean         @default(false)
    connectedPhone        String?
    connectedAt           DateTime?
    disconnectedAt        DateTime?
    messagesCount         Int             @default(0)
    activeChatCount       Int             @default(0)
    lastTestAt            DateTime?
    lastTestOk            Boolean?
    lastTestError         String?
    lastErrorAt           DateTime?
    lastErrorMessage      String?
    createdAt             DateTime        @default(now())
    updatedAt             DateTime        @updatedAt
}

model WhatsappConversation {
    id              String                      @id @default(uuid())
    // E.164 phone number (canonical +9665XXXXXXXX for Saudi)
    phone           String                      @unique
    // Resolved Client.id (nullable — WALK_IN client may not exist yet)
    clientId        String?
    status          WhatsappConversationStatus  @default(ACTIVE)
    language        String                      @default("ar")
    // Accumulated state (collected name, email, chosenServiceId, etc.)
    context         Json?
    // Staff handover to a human (auto-reply disabled while true)
    staffTakeover   Boolean                     @default(false)
    staffUserId     String?
    staffTookOverAt DateTime?
    lastMessageAt   DateTime                    @default(now())
    createdAt       DateTime                    @default(now())
    updatedAt       DateTime                    @updatedAt

    messages WhatsappMessage[]

    @@index([status, lastMessageAt(sort: Desc)])
    @@index([clientId])
    @@index([lastMessageAt(sort: Desc)])
}

model WhatsappMessage {
    id                String                @id @default(uuid())
    conversationId    String
    role              WhatsappMessageRole
    content           String
    toolCalls         Json?
    toolResults       Json?
    tokenUsage        Int?
    latencyMs         Int?
    // External message id (Meta Cloud wamid / Baileys message id) for idempotency
    externalMessageId String?               @unique
    // Links one generated reply to one inbound provider message for retry safety.
    inReplyToExternalMessageId String?       @unique
    deliveryStatus    WhatsappDeliveryStatus?
    providerMessageId String?
    errorMessage      String?
    createdAt         DateTime              @default(now())

    conversation WhatsappConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

    @@index([conversationId, createdAt(sort: Desc)])
}
